[TEMPLATE]
# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TheGamesDB — free video game database (posters, descriptions, genres, etc.)
# Get an API key at https://thegamesdb.net (login → API Access).
# Server-side only — never prefix with NEXT_PUBLIC_ and never expose to the browser.
THEGAMESDB_API_KEY=
